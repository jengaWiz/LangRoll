{
  "name": "@langroll/api",
  "private": true,
  "description": "LangRoll backend API: accounts, progress sync and review scheduling.",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "pino-pretty": "^13.2.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "fastify": "^5.12.8",
    "zod": "^4.6.7"
  }
}
