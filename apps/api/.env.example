# Copy to .env for local development. Never commit .env.
DATABASE_URL=postgres://postgres@127.0.0.1:5432/langroll
LOG_LEVEL=debug
# Supabase project URL (Settings -> API). The local Supabase CLI serves http://127.0.0.1:54321.
SUPABASE_URL=http://127.0.0.1:54321
# Web pages allowed to call the API from a browser (comma-separated origins, no paths).
CORS_ORIGINS=http://127.0.0.1:4173,http://localhost:4173
# Proxies in front of the API (1 behind Fly/Railway load balancers, 0 locally).
TRUST_PROXY_HOPS=0
# Azure AI Speech, for pronunciation scoring (optional; without it the app uses the phone's
# recognition). On Fly the key is a secret: fly secrets set AZURE_SPEECH_KEY=... (never commit it).
# AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=eastus
# Pronunciation checks per learner per day (UTC); each one is billed. Past it, the app uses the
# phone's own recognition. Defaults to 15.
# SPEECH_DAILY_LIMIT=15
