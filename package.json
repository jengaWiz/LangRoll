{
  "name": "langroll",
  "private": true,
  "description": "LangRoll landing page and app. Static files, no build step; these scripts are for CI checks only.",
  "type": "module",
  "workspaces": [
    "apps/api"
  ],
  "scripts": {
    "lint": "npm run lint:js && npm run lint:css && npm run lint:html",
    "lint:js": "eslint .",
    "lint:css": "stylelint \"**/*.css\"",
    "lint:html": "html-validate \"**/*.html\"",
    "check:assets": "node scripts/check-assets.mjs",
    "check:qr": "node scripts/make-qr.mjs --check",
    "test:smoke": "playwright test",
    "check": "npm run lint && npm run check:assets && npm run check:qr && npm run test:smoke",
    "build": "node scripts/build-site.mjs",
    "serve": "node scripts/serve.mjs",
    "qr": "node scripts/make-qr.mjs",
    "audio": "node --env-file-if-exists=.env scripts/generate-audio.mjs",
    "scenes": "node scripts/scene-picker.mjs",
    "typecheck": "npm run typecheck -w @langroll/api",
    "test:api": "npm test -w @langroll/api",
    "dev:api": "npm run dev -w @langroll/api"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.64.1",
    "eslint": "^9.39.5",
    "globals": "^15.15.0",
    "html-validate": "^11.21.1",
    "qrcode": "^1.5.4",
    "stylelint": "^16.26.1",
    "stylelint-config-recommended": "^14.0.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2"
  }
}
