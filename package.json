{
  "name": "langroll",
  "private": true,
  "description": "LangRoll landing page and app. Static files, no build step; these scripts are for CI checks only.",
  "type": "module",
  "scripts": {
    "lint": "npm run lint:js && npm run lint:css && npm run lint:html",
    "lint:js": "eslint .",
    "lint:css": "stylelint \"**/*.css\"",
    "lint:html": "html-validate \"**/*.html\"",
    "check:assets": "node scripts/check-assets.mjs",
    "check:qr": "node scripts/make-qr.mjs --check",
    "test:smoke": "playwright test",
    "check": "npm run lint && npm run check:assets && npm run check:qr && npm run test:smoke",
    "serve": "node scripts/serve.mjs",
    "qr": "node scripts/make-qr.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.64.1",
    "eslint": "^9.39.5",
    "globals": "^15.15.0",
    "html-validate": "^9.7.1",
    "qrcode": "^1.5.4",
    "stylelint": "^16.26.1",
    "stylelint-config-recommended": "^14.0.1"
  }
}
